{
  "name": "@lightconexyz/lightcone-sdk-rescript",
  "version": "0.9.0-rc.1",
  "description": "ReScript SDK for Lightcone (gentype-exported for TypeScript consumers)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/src/BrowserApi.gen.d.ts",
      "import": "./src/BrowserApi.res.mjs"
    },
    "./src/*": "./src/*",
    "./bindings/*": "./bindings/*",
    "./server": {
      "types": "./types/src/ServerApi.gen.d.ts",
      "import": "./src/ServerApi.res.mjs"
    }
  },
  "types": "./types/src/BrowserApi.gen.d.ts",
  "module": "./src/BrowserApi.res.mjs",
  "trustedDependencies": [
    "@mununki/ppx-spice",
    "esbuild"
  ],
  "dependencies": {
    "@mununki/ppx-spice": "^0.4.1",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "^2.0.0",
    "@rescript/runtime": "^12.3.0",
    "@solana-program/token": "0.16.0",
    "@solana/kit": "8.0.0",
    "decimal.js": "^10.6.0",
    "json-bigint": "1.0.0",
    "sorted-btree": "^2.1.0",
    "tweetnacl": "1.0.3",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^22",
    "esbuild": "0.25.11",
    "rescript": "^12.3.0",
    "rescript-bun": "^2.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5"
  },
  "scripts": {
    "build": "rescript && node scripts/gentype-namespace.mjs && tsc -p tsconfig.declarations.json",
    "clean": "rescript clean",
    "dev": "rescript watch",
    "test": "bun run build && bun test ./tests/*Test.res.mjs ./bindings/*/tests/*Test.res.mjs ./tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:consumers": "bun run build && node scripts/check-consumers.mjs",
    "test:browser": "bun run build && playwright test",
    "prepack": "bun run build"
  },
  "files": [
    "src",
    "bindings",
    "rescript.json",
    "README.md",
    "!bindings/*/tests",
    "types"
  ],
  "engines": {
    "node": ">=24"
  }
}
