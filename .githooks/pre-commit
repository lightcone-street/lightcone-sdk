#!/usr/bin/env bash

REPO_DIR="$(git rev-parse --show-toplevel)"

# ── Cargo fmt ──────────────────────────────────────────────────
staged_rust_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$staged_rust_files" ]; then
    echo "Running cargo fmt..."
    cargo fmt --manifest-path rust/Cargo.toml
    echo "$staged_rust_files" | xargs git add
fi

# ── SDK Examples Check ─────────────────────────────────────────

if [ "${SKIP_EXAMPLES:-0}" = "1" ]; then
    echo ""
    echo "⚠ SKIP_EXAMPLES=1 — skipping SDK examples check"
    exit 0
fi

echo ""
echo "═══════════════════════════════════════════════════════════════"
echo "  SDK Examples Check"
echo ""
echo "  Before committing, please ensure the SDK examples pass"
echo "  against your local backend running the latest staging branch"
echo "  (plus any related backend changes for this SDK work)."
echo "═══════════════════════════════════════════════════════════════"
echo ""
echo "  1) No, run them for me now"
echo "  2) No, I'll run them manually first"
echo "  3) I need to rebase my local backend to latest staging first"
echo "  4) The examples failed — I'll fix and try again"
echo "  5) Yes, I ran them and they all passed"
echo ""

if ! read -t 30 -r -p "Select an option [1-5]: " choice < /dev/tty 2>/dev/null; then
    echo ""
    echo "No input received — non-interactive environment (lazygit, IDE, etc.)"
    echo ""
    echo "  Run examples first:  LIGHTCONE_ENV=local ./scripts/run-examples.sh"
    echo "  Then commit with:    SKIP_EXAMPLES=1 git commit"
    exit 1
fi

case "$choice" in
    1)
        echo ""
        echo "Checking local backend health..."
        if ! curl -sf https://api.local.lightcone.xyz/health > /dev/null 2>&1; then
            echo "✗ Local backend is not responding at https://api.local.lightcone.xyz/health"
            echo "  Start your local backend and try again."
            exit 1
        fi
        echo "✓ Local backend is healthy"
        echo ""

        LIGHTCONE_ENV=local "$REPO_DIR/scripts/run-examples.sh"
        exit $?
        ;;
    2)
        echo ""
        echo "Aborting commit. Run examples manually with:"
        echo ""
        echo "  LIGHTCONE_ENV=local ./scripts/run-examples.sh"
        echo ""
        exit 1
        ;;
    3)
        echo ""
        echo "Aborting commit. Rebase your local backend to latest staging, then run examples."
        exit 1
        ;;
    4)
        echo ""
        echo "Aborting commit. Fix the failing examples and try again."
        exit 1
        ;;
    5)
        echo "✓ Proceeding with commit"
        exit 0
        ;;
    *)
        echo "Invalid option. Aborting commit."
        exit 1
        ;;
esac
